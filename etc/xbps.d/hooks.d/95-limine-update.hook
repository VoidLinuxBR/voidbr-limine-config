# Roda o update-limine só quando um pacote instala ou atualiza um kernel,
# ou seja, quando ele traz um /boot/vmlinuz-*. Assim linux-firmware,
# linux-headers e afins não disparam o hook, e qualquer kernel (linuxX.Y,
# mainline ou um kernel próprio) é coberto sem listar nomes de pacote.
# A remoção de kernel é tratada pelo /etc/kernel.d/post-remove/90-limine.
[Trigger]
Type      = Path
Operation = Install
Operation = Upgrade
Target    = /boot/vmlinuz-*

[Action]
Description = Copiando kernel/initramfs pro ESP (Limine)
When        = PostTransaction
#Exec        = /etc/xbps.d/hooks.d/scripts/voidbr-limine-update
Exec        = /usr/local/bin/update-limine
