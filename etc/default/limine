# /etc/default/limine
# Configuration file for Limine (lido por update-limine)
#
# Este arquivo é opcional. Se não existir, ou se alguma variável não for
# definida aqui, o update-limine usa os valores padrão definidos internamente
# (os mesmos valores já preenchidos abaixo).
#

# Tempo (em segundos) que o menu de boot fica visível antes de escolher
# a entrada padrão automaticamente.
LIMINE_TIMEOUT=5

# Saída detalhada do Limine durante o boot (yes/no).
LIMINE_VERBOSE=no

# Nome usado no título das entradas de menu geradas para cada kernel
# instalado (ex: "/VoidBR (Kernel 6.6.30_1)").
LIMINE_DISTRO_NAME="VoidBR"

# Parâmetros extras adicionados à linha de comando do kernel (cmdline),
# em toda entrada gerada (normal e recovery). O "root=UUID=..." já é
# adicionado automaticamente pelo update-limine, não repita aqui.
#
# Exemplo com disco criptografado (LUKS/LVM), preenchido automaticamente
# pelo instalador quando a criptografia é ativada:
# LIMINE_CMDLINE_LINUX_DEFAULT="rw loglevel=4 rd.luks.allow-discards rd.lvm.vg=voidvg rd.luks.uuid=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LIMINE_CMDLINE_LINUX_DEFAULT="rw loglevel=4 video=1920x1080 quiet splash plymouth.enable=1 libata.noacpi=1 acpi=force apm=power-off nowatchdog tsc=nowatchdog cryptomgr.notests no_timer_check rcupdate.rcu_expedited=1 intel_pstate=active amd_pstate=active cpuidle.governor=teo split_lock_detect=off clearcpuid=514 transparent_hugepage=never skew_tick=1 intremap=off nosoftlockup audit=0 nomce rd.udev.log_level=3 apparmor=1 security=apparmor vconsole.font=Uni2-Fixed16 intel_iommu=on amd_iommu=on tdx=on nvme_load=yes nouveau.modeset=1 i915.modeset=1 amdgpu.modeset=1 radeon.si_support=0 radeon.cik_support=0 amdgpu.si_support=1 amdgpu.cik_support=1 nvidia.modeset=1 nvidia_drm.modeset=1 pcie_aspm=off amdgpu.aspm=0"

# --- Aparência do menu ---

# Paletas de cor do terminal (8 cores, separadas por ";"): normal e "bright".
# Tema Tokyo Night (night), combinando com a wallpaper voidbr-tokyonight.png.
LIMINE_TERM_PALETTE="15161e;f7768e;9ece6a;e0af68;7aa2f7;bb9af7;7dcfff;a9b1d6"
LIMINE_TERM_PALETTE_BRIGHT="414868;ff899d;9fe044;faba4a;8db0ff;c7a9ff;a4daff;c0caf5"

# Cores de fundo/texto do terminal (formato hexadecimal ARGB/RGB do Limine).
LIMINE_TERM_BACKGROUND="ffffffff"
LIMINE_TERM_FOREGROUND="c0caf5"
LIMINE_TERM_BACKGROUND_BRIGHT="ffffffff"
LIMINE_TERM_FOREGROUND_BRIGHT="c0caf5"

# Wallpaper exibido no menu (nome do arquivo, dentro de /boot/efi/limine/).
# O caminho completo é montado automaticamente pelo update-limine.
LIMINE_WALLPAPER="voidbr-tokyonight.png"
LIMINE_WALLPAPER_STYLE="stretched"

# Texto exibido no topo do menu e sua cor (RRGGBB).
# Deixe LIMINE_BRANDING="" para não mostrar nada.
LIMINE_BRANDING="VoidBR Linux"
LIMINE_BRANDING_COLOR="7aa2f7"
