pkgname=voidbr-limine-config
pkgdesc="VoidBR config for Limine"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=(voidbr-limine-theme)    # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=(voidbr-limine-theme)    # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=(voidbr-limine-theme)   # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(limine)
backup=()

package() {
	# Verify default folder
  if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
  elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
    #local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	if [ -n "$MKISO_BUILD" ]; then
  	update-limine
  fi
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
	if [ -n "$MKISO_BUILD" ]; then
  	update-limine
  fi
}
