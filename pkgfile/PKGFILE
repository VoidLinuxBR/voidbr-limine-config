pkgname=voidbr-limine-config
pkgdesc="VoidBR config for Limine"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=(voidbr-limine-theme)  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=(voidbr-limine-theme)  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=(voidbr-limine-theme) # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(limine)
backup=(/etc/default/limine)

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

# post_install e post_upgrade fazem a mesma coisa. A lógica fica só aqui e o
# post_upgrade chama esta função. Não dá pra usar uma função auxiliar: o
# pkgmake só copia pre/post_install e pre/post_upgrade para o INSTALL.
post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	if [ -n "${MKISO_BUILD:-}" ]; then
		echo "${YELLOW}[-]${RESET} Build de ISO detectado (MKISO_BUILD) — pulando."
		return 0
	fi

	# Binários do Limine: copiados do pacote limine (/usr/share/limine) para a
	# ESP, assim ficam sempre na mesma versão do limine instalado.
	# Se /boot/efi está no fstab mas não montada, não copia nada (iria pro
	# disco raiz).
	if findmnt -s -n /boot/efi >/dev/null 2>&1 && ! mountpoint -q /boot/efi; then
		echo "${YELLOW}[!]${RESET} /boot/efi não está montada — binários do Limine não copiados." >&2
	else
		mkdir -p /boot/efi/EFI/limine /boot/efi/limine 2>/dev/null || true

		if [ -f /usr/share/limine/BOOTX64.EFI ]; then
			cp /usr/share/limine/BOOTX64.EFI /boot/efi/EFI/limine/BOOTX64.EFI ||
				echo "${YELLOW}[!]${RESET} falha ao copiar BOOTX64.EFI para /boot/efi/EFI/limine/" >&2

			# Carregador de reserva da ESP: só grava se não existir ou se já
			# for do Limine, para não sobrescrever o de outro sistema.
			fallback=/boot/efi/EFI/BOOT/BOOTX64.EFI
			if [ ! -f "$fallback" ] || grep -q 'Limine' "$fallback" 2>/dev/null; then
				mkdir -p /boot/efi/EFI/BOOT 2>/dev/null || true
				cp /usr/share/limine/BOOTX64.EFI "$fallback" ||
					echo "${YELLOW}[!]${RESET} falha ao copiar BOOTX64.EFI para /boot/efi/EFI/BOOT/" >&2
			fi
		fi

		if [ -f /usr/share/limine/limine-bios.sys ]; then
			cp /usr/share/limine/limine-bios.sys /boot/efi/limine/limine-bios.sys ||
				echo "${YELLOW}[!]${RESET} falha ao copiar limine-bios.sys para /boot/efi/limine/" >&2
		fi
	fi

	# Dentro do instalador o update-limine é chamado depois, pelo próprio instalador.
	[ -n "${VOIDBR_INSTALLER:-}" ] && return 0

	if ! /usr/bin/update-limine; then
		echo "${YELLOW}[!]${RESET} update-limine falhou — confira o limine.conf antes de reiniciar." >&2
	fi
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
