# Cores ANSI (desativadas automaticamente se a saída não for um terminal)
if [ -t 1 ]; then
  red='\033[1;31m'
  green='\033[1;32m'
  yellow='\033[1;33m'
  blue='\033[1;34m'
  cyan='\033[1;36m'
  bold='\033[1m'
  reset='\033[0m'
else
  red=''; green=''; yellow=''; blue=''; cyan=''; bold=''; reset=''
fi

if [ "$(id -u)" -ne 0 ]; then
    printf "${red}Erro:${reset} este script deve ser executado como root.\n" >&2
    exit 1
fi
printf "${blue}==>${reset} Gerando o arquivo de configuração do limine...\n"

# Valores padrão. Por cima deles são lidos, nesta ordem (shell puro,
# VAR=valor, igual ao GRUB):
#   /etc/limine.d/10_linux  - parâmetros fixos do kernel (LIMINE_CMDLINE_LINUX)
#   /etc/default/limine     - ajustes da máquina (LIMINE_CMDLINE_LINUX_DEFAULT,
#                             tema, timeout...)
LIMINE_TIMEOUT=5
LIMINE_VERBOSE=no
LIMINE_CMDLINE_LINUX="rw loglevel=4"
LIMINE_CMDLINE_LINUX_DEFAULT=""
LIMINE_DISTRO_NAME="VoidBR"
LIMINE_TERM_PALETTE="15161e;f7768e;9ece6a;e0af68;7aa2f7;bb9af7;7dcfff;a9b1d6"
LIMINE_TERM_PALETTE_BRIGHT="414868;ff899d;9fe044;faba4a;8db0ff;c7a9ff;a4daff;c0caf5"
LIMINE_TERM_BACKGROUND="ffffffff"
LIMINE_TERM_FOREGROUND="c0caf5"
LIMINE_TERM_BACKGROUND_BRIGHT="ffffffff"
LIMINE_TERM_FOREGROUND_BRIGHT="c0caf5"
LIMINE_WALLPAPER="voidbr-tokyonight.png"
LIMINE_WALLPAPER_STYLE="stretched"
LIMINE_BRANDING=""
LIMINE_BRANDING_COLOR="7aa2f7"
LIMINE_HELP_HIDDEN="yes"
# shellcheck disable=SC1091
[ -r /etc/limine.d/10_linux ] && . /etc/limine.d/10_linux
# shellcheck disable=SC1091
[ -r /etc/default/limine ] && . /etc/default/limine

boot=/boot
#cfg="${boot}/limine.conf"
#boot_limine="/"
dest="${boot}/efi/limine"
cfg="${dest}/limine.conf"
boot_limine="/limine"
root_uuid=$(findmnt -no UUID /)

# ESP no fstab mas não montada: sem esta checagem o kernel e o limine.conf
# seriam gravados no disco raiz, e o boot continuaria com a config antiga.
# Em instalação só BIOS o /boot/efi não costuma estar no fstab, então segue.
esp="${boot}/efi"
if findmnt -s -n "$esp" >/dev/null 2>&1 && ! mountpoint -q "$esp"; then
  printf "${red}Erro:${reset} %s está no /etc/fstab, mas não está montada.\n" "$esp" >&2
  printf "       Monte com: mount %s\n" "$esp" >&2
  exit 1
fi

[ -n "$root_uuid" ] || { printf "${red}Erro:${reset} UUID da raiz (/) não encontrado.\n" >&2; exit 1; }

# btrfs com subvolumes: o Limine não lê btrfs, então o kernel não sabe qual
# subvolume montar como / sem o rootflags=subvol=... (o GRUB faz isso sozinho).
# Rodando de dentro de um snapshot (@snapshots/N/snapshot), o destino é o @.
root_flags=""
if [ "$(findmnt -no FSTYPE /)" = "btrfs" ]; then
  root_fsroot=$(findmnt -no FSROOT /)
  case "$root_fsroot" in
    /|"")                     root_subvol="" ;;
    /@snapshots/*/snapshot)   root_subvol="@" ;;
    *)                        root_subvol=${root_fsroot#/} ;;
  esac
  [ -n "$root_subvol" ] && root_flags=" rootflags=subvol=${root_subvol}"
fi
# Cmdline final: fixos (10_linux) + extras (/etc/default/limine), nessa
# ordem, sem parâmetros idênticos repetidos (fica o primeiro). Máquinas
# antigas ainda têm a lista inteira no /etc/default/limine; assim ela não
# sai em dobro. Valores diferentes (loglevel=4 e loglevel=3) ficam os dois,
# e o kernel usa o último, que é o do /etc/default/limine.
# Modo de recuperação: mesma cmdline, sem quiet/splash/plymouth, para as
# mensagens de boot aparecerem. set -f evita expandir curingas da cmdline.
cmdline=""
recovery_cmdline=""
set -f
for w in $LIMINE_CMDLINE_LINUX $LIMINE_CMDLINE_LINUX_DEFAULT; do
  case " $cmdline " in
    *" $w "*) continue ;;
  esac
  cmdline="${cmdline:+$cmdline }$w"
  case "$w" in
    quiet|splash|plymouth.enable=*) ;;
    *) recovery_cmdline="${recovery_cmdline:+$recovery_cmdline }$w" ;;
  esac
done
set +f

set -- "$boot"/vmlinuz-*

[ -e "$1" ] || exit 0

mkdir -p "$dest"
sorted_kernels=$(printf '%s\n' "$@" | sort -Vr)

# --- Verifica espaço disponível no destino ---
# Os kernels/initramfs que já estão no destino contam como espaço livre: os
# que continuarem selecionados e forem idênticos não são recopiados, e os
# demais saem. Os kernels de snapshots ($dest/snapshots) também contam como
# livres: os do sistema têm prioridade, e o voidbr-snapper-manager recopia
# os dos snapshots depois, só com o espaço que sobrar.
avail=$(df --output=avail -B1 "$dest" 2>/dev/null | tail -n1 | tr -d ' ')
avail_known=1
if ! printf '%s' "$avail" | grep -Eq '^[0-9]+$'; then
  avail_known=0
  avail=0
else
  for f in "$dest"/vmlinuz-* "$dest"/initramfs-*.img "$dest"/snapshots/*; do
    [ -f "$f" ] || continue
    avail=$((avail + $(stat -c%s "$f" 2>/dev/null || echo 0)))
  done
fi

copy_list=""
keep_versions=""

if [ "$avail_known" -eq 0 ]; then
  # Não deu pra medir o espaço livre: por segurança, não arrisca copiar
  # tudo às cegas nem aborta sem gerar config — copia só o mais novo.
  printf "${yellow}Aviso:${reset} não foi possível checar o espaço disponível em %s — copiando apenas o kernel mais novo por segurança.\n" "$dest" >&2
  newest_kernel=$(printf '%s\n' "$sorted_kernels" | head -n1)
  newest_version=${newest_kernel##*/vmlinuz-}
  newest_initramfs="${boot}/initramfs-${newest_version}.img"
  if [ -f "$newest_initramfs" ]; then
    copy_list="${newest_kernel};${newest_initramfs}
"
    keep_versions="${newest_version}
"
  fi
else
  # --- Preenchimento guloso: começa pelo kernel mais novo e vai incluindo
  #     os seguintes enquanto couber no espaço livre. Assim que um não
  #     couber, para por ali — os mais antigos ficam de fora. ---
  printf "${blue}==>${reset} Selecionando kernels (do mais novo ao mais antigo, conforme espaço)...\n"
  running_total=0
  for kernel in $sorted_kernels; do
    version=${kernel##*/vmlinuz-}
    initramfs="${boot}/initramfs-${version}.img"
    [ -f "$initramfs" ] || continue

    ksize=$(stat -c%s "$kernel" 2>/dev/null || echo 0)
    isize=$(stat -c%s "$initramfs" 2>/dev/null || echo 0)
    pair_size=$((ksize + isize))
    pair_required=$((pair_size + pair_size / 10))  # +10% de margem (overhead de FS)

    if [ $((running_total + pair_required)) -le "$avail" ]; then
      copy_list="${copy_list}${kernel};${initramfs}
"
      keep_versions="${keep_versions}${version}
"
      running_total=$((running_total + pair_size))
    else
      printf "${yellow}Espaço esgotado${reset} em %s — parando em '%s', kernels mais antigos ficarão de fora.\n" "$dest" "$version"
      break
    fi
  done
fi

if [ -z "$copy_list" ]; then
  printf "${red}Erro:${reset} sem espaço suficiente em %s para copiar nenhum kernel.\n" "$dest" >&2
  exit 1
fi

printf "${cyan}Kernels selecionados:${reset}\n"
printf '%s' "$keep_versions" | sed '/^$/d' | while read -r v; do
  printf "  ${green}✓${reset} %s\n" "$v"
done

# --- Limpa o destino: sai o que não foi selecionado ---
printf "${blue}==>${reset} Limpando destino (%s)...\n" "$dest"
for f in "$dest"/vmlinuz-* "$dest"/initramfs-*.img; do
  [ -e "$f" ] || continue
  v=${f##*/}; v=${v#vmlinuz-}; v=${v#initramfs-}; v=${v%.img}
  printf '%s' "$keep_versions" | grep -qxF "$v" || rm -f "$f"
done
for f in "$dest"/snapshots/*; do
  [ -e "$f" ] && rm -f "$f"
done

# --- Copia os selecionados (só o que mudou) ---
printf "${blue}==>${reset} Copiando arquivos...\n"
printf '%s' "$copy_list" | while IFS=';' read -r kernel initramfs; do
  [ -n "$kernel" ] || continue
  for src in "$kernel" "$initramfs"; do
    cmp -s "$src" "$dest/${src##*/}" && continue
    if ! cp -a "$src" "$dest/"; then
      printf "${red}Erro:${reset} falha ao copiar %s para %s\n" "$src" "$dest" >&2
      exit 1
    fi
  done
done || exit 1

if [ -f /boot/memtest.bin ]; then
  cp -a /boot/memtest.bin "$dest"/ || true
fi

printf "${blue}==>${reset} Adicionando entradas de menu...\n"
{
  echo '# VoidBR Limine theme'
  echo '# Author: Vilmar Catafesta <vcatafesta@gmail.com>'
  echo '# Gerado por update-limine — não edite. Use /etc/default/limine e /etc/limine.d/10_linux.'
  echo
  echo "TIMEOUT: ${LIMINE_TIMEOUT}"
  echo "VERBOSE: ${LIMINE_VERBOSE}"
  echo "term_palette: ${LIMINE_TERM_PALETTE}"
  echo "term_palette_bright: ${LIMINE_TERM_PALETTE_BRIGHT}"
  echo "term_background: ${LIMINE_TERM_BACKGROUND}"
  echo "term_foreground: ${LIMINE_TERM_FOREGROUND}"
  echo "term_background_bright: ${LIMINE_TERM_BACKGROUND_BRIGHT}"
  echo "term_foreground_bright: ${LIMINE_TERM_FOREGROUND_BRIGHT}"
  # interface_branding sem valor esconde o texto padrão do Limine
  # ("Limine x.y.z (x86-64, UEFI)"), que ficaria em cima do logo da wallpaper.
  if [ -n "$LIMINE_BRANDING" ]; then
    echo "interface_branding: ${LIMINE_BRANDING}"
    echo "interface_branding_colour: ${LIMINE_BRANDING_COLOR}"
  else
    echo 'interface_branding:'
  fi
  # Linha de ajuda das teclas (ARROWS/ENTER/E/S/B) no topo; as teclas
  # continuam funcionando quando ela está escondida.
  [ "$LIMINE_HELP_HIDDEN" = "yes" ] && echo 'interface_help_hidden: yes'
  echo "wallpaper: boot():${boot_limine}/${LIMINE_WALLPAPER}"
  echo "wallpaper_style: ${LIMINE_WALLPAPER_STYLE}"
  echo

  printf '%s' "$copy_list" | while IFS=';' read -r kernel initramfs; do
    [ -n "$kernel" ] || continue
    version=${kernel##*/vmlinuz-}
    printf '/%s (Kernel %s)\n' "$LIMINE_DISTRO_NAME" "$version"
    printf '    PROTOCOL: linux\n'
    printf '    PATH: boot():%s/vmlinuz-%s\n' "$boot_limine" "$version"
    printf '    MODULE_PATH: boot():%s/initramfs-%s.img\n' "$boot_limine" "$version"
    printf '    CMDLINE: root=UUID=%s %s%s\n' "$root_uuid" "$cmdline" "$root_flags"
    printf '\n'
    printf '/%s Recover Mode (Kernel %s)\n' "$LIMINE_DISTRO_NAME" "$version"
    printf '    PROTOCOL: linux\n'
    printf '    PATH: boot():%s/vmlinuz-%s\n' "$boot_limine" "$version"
    printf '    MODULE_PATH: boot():%s/initramfs-%s.img\n' "$boot_limine" "$version"
    printf '    CMDLINE: root=UUID=%s %s%s single\n' "$root_uuid" "$recovery_cmdline" "$root_flags"
    printf '\n'
  done

  # Submenu de snapshots (voidbr-snapper-manager). As mensagens dele vão
  # para stderr; só as entradas vão para o limine.conf.
  if [ -n "$root_flags" ] && command -v voidbr-snapper-manager >/dev/null 2>&1; then
    voidbr-snapper-manager limine-entries "$root_uuid" "$cmdline" "$boot_limine" "$dest"
  fi

  # Títulos do menu: a fonte do Limine é CP437, que não tem ã/õ.
  echo '/Ajustes do Firmware UEFI'
  echo '  protocol: efi_boot_entry'
  echo '  entry: UEFI Firmware Settings'
  echo '  if_fw_type: UEFI'
  echo

  # Windows só entra se estiver no firmware. Sem efibootmgr não dá pra saber,
  # então mantém a entrada (comportamento antigo).
  show_windows=1
  if command -v efibootmgr >/dev/null 2>&1; then
    efibootmgr 2>/dev/null | grep -q 'Windows Boot Manager' || show_windows=0
  fi
  if [ "$show_windows" -eq 1 ]; then
    echo '/Windows Boot Manager'
    echo '  protocol: efi_boot_entry'
    echo '  entry: Windows Boot Manager'
    echo '  if_fw_type: UEFI'
    echo
  fi
  if [ -f "$dest/memtest.bin" ]; then
    echo '/Executar Memtest86+ (teste de RAM)'
    echo '  protocol: linux'
    echo "  path: boot():${boot_limine}/memtest.bin"
  fi

} > "${cfg}.new"
mv "${cfg}.new" "$cfg"

printf "${green}${bold}✓ Concluído!${reset} configuração escrita em %s\n" "$cfg"
